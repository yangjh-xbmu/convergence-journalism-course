---
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="nordic-hero-block">
  <div class="hero-inner">
    <div class="hero-affiliation-bar">
      <span>西北民族大学新闻传播学院</span>
      <span class="sep-dot">·</span>
      <strong>新闻学专业 卓越实验班</strong>
      <span class="sep-dot">·</span>
      <span>2026-2027 学年第一学期</span>
    </div>

    <span class="overline-tag">CONVERGENT JOURNALISM PRODUCT DESIGN</span>
    
    <h1 id="_top" data-page-title class="masthead-h1">{title}</h1>
    
    <p class="masthead-subtitle">Planning and Production of Convergent Journalism Products</p>

    <div class="lead-reading-box">
      本课程与《新媒体运营》确立“产品研发—运营增长”双螺旋协同框架，定位于内容研发中台与技术兵工厂。我们打破零散聊天的操作依赖，将现代新闻专业主义的可署名责任，锚定在严密的 AI Agent 工业化流水线、多源证据三角互证与本地结构化 Wiki 知识库之中，旨在培养兼具工程量化思维与深度视听表达的复合型全媒体创作者。
    </div>

    <!-- 课程核心事实条 (Factbar) -->
    <div class="fact-strip">
      <div class="fact-item">
        <span class="fact-kicker">总学时规制</span>
        <div class="fact-num">32<span>学时</span></div>
      </div>
      <div class="fact-item">
        <span class="fact-kicker">理论实践配比</span>
        <div class="fact-num">16 / 16<span>学时</span></div>
      </div>
      <div class="fact-item">
        <span class="fact-kicker">教学日程周期</span>
        <div class="fact-num">前 8 周<span>周三 1-4 节</span></div>
      </div>
      <div class="fact-item">
        <span class="fact-kicker">实训工作书舍</span>
        <div class="fact-num">致美楼 309<span>实验室</span></div>
      </div>
    </div>

    <!-- 课程元数据副条 -->
    <div class="meta-sub-bar">
      <span>课程代字：<strong>23120616B</strong></span>
      <span>主讲学人：<strong>杨志宏 博士（副教授、新闻系主任）</strong></span>
      <span>工程仓库：<strong>yangjh-xbmu/teaching-2026-2027-s1</strong></span>
    </div>

    <!-- 核心操作按键行 -->
    <div class="hero-action-dock">
      <a href="/lectures/week5/" class="hero-btn hero-btn-primary">
        <span>查阅本周主讲讲义（第05周）</span>
        <span class="btn-arrow">➔</span>
      </a>
      <a href="/syllabus/" class="hero-btn hero-btn-secondary">
        <span>教学大纲与规程</span>
      </a>
      <a href="/guides/issue-guidelines/" class="hero-btn hero-btn-minimal">
        <span>GitHub Issue 提问向导</span>
      </a>
    </div>
  </div>
</div>

<style>
  .nordic-hero-block {
    width: 100%;
    padding-top: var(--hero-padding-top);
    padding-bottom: var(--hero-padding-bottom);
    border-bottom: 2px solid var(--rule-bold);
    margin-bottom: var(--space-8);
  }

  .hero-inner {
    max-width: var(--container-max-width);
    margin-inline: auto;
  }

  .hero-affiliation-bar {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    font-family: var(--font-serif);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule-hairline);
    letter-spacing: 0.06em;
  }

  .hero-affiliation-bar strong {
    color: var(--ink-title);
    font-weight: 700;
  }

  .sep-dot {
    color: var(--rule-hairline);
  }

  .overline-tag {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: var(--space-4);
    display: block;
    font-family: var(--font-mono);
  }

  .masthead-h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.4rem + 3.2vw, 4.2rem);
    font-weight: 900;
    color: var(--ink-title);
    line-height: 1.18;
    letter-spacing: 0.02em;
    margin-top: 0;
    margin-bottom: var(--space-4);
    padding-bottom: 0;
    border-bottom: none !important;
  }

  .masthead-subtitle {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink-muted);
    font-style: italic;
    margin-top: 0;
    margin-bottom: var(--space-8);
    letter-spacing: 0.02em;
  }

  .lead-reading-box {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 2.0;
    color: var(--ink-title);
    max-width: 44em;
    margin-bottom: var(--space-10);
    text-align: start;
    word-break: normal;
  }

  /* 事实条 */
  .fact-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--rule-bold);
    border-bottom: 1px solid var(--rule-hairline);
    padding-block: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .fact-item {
    padding-right: var(--space-6);
  }

  .fact-item + .fact-item {
    border-left: 1px solid var(--rule-hairline);
    padding-left: var(--space-6);
  }

  .fact-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-1);
    display: block;
    font-weight: 600;
  }

  .fact-num {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.1rem + 1vw, 2.2rem);
    line-height: 1.1;
    color: var(--ink-title);
    font-weight: 700;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  .fact-num span {
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--ink-muted);
    margin-left: var(--space-1);
    font-weight: normal;
    white-space: nowrap;
  }

  .meta-sub-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    font-size: 0.875rem;
    color: var(--ink-muted);
    margin-bottom: var(--space-10);
    font-family: var(--font-sans);
  }

  .meta-sub-bar strong {
    color: var(--ink-title);
    font-weight: 600;
  }

  /* 按键行 */
  .hero-action-dock {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .hero-btn-primary {
    background-color: var(--accent-primary);
    color: var(--color-linen-50) !important;
    border: 1px solid var(--accent-primary);
  }

  .hero-btn-primary:hover {
    background-color: var(--color-terracotta-600);
    border-color: var(--color-terracotta-600);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .hero-btn-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .hero-btn-secondary {
    background-color: var(--paper-surface);
    color: var(--ink-title) !important;
    border: 1px solid var(--rule-bold);
  }

  .hero-btn-secondary:hover {
    background-color: var(--paper-dim);
  }

  .hero-btn-minimal {
    background-color: transparent;
    color: var(--ink-muted) !important;
    border: 1px solid var(--rule-hairline);
  }

  .hero-btn-minimal:hover {
    color: var(--ink-title) !important;
    border-color: var(--ink-title);
  }

  @media (max-width: 1024px) {
    .fact-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
    .fact-item + .fact-item {
      border-left: none;
      padding-left: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-affiliation-bar {
      flex-direction: column;
      gap: var(--space-1);
    }
    .meta-sub-bar {
      flex-direction: column;
      gap: var(--space-2);
    }
    .hero-action-dock {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-btn {
      justify-content: center;
    }
  }
</style>
